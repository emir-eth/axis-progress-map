# Copy to `.env.local` and adjust if needed.
# Never commit `.env.local`.

# Public Base RPC (server-side only)
BASE_RPC_URL=https://mainnet.base.org

# Optional tuning — defaults work for most local / VPS setups
# BASE_LOG_CHUNK_SIZE=10000
# BASE_LOG_CONCURRENCY=4
# BASE_BLOCK_BATCH_SIZE=10
# AXIS_START_BLOCK=43731412

# Development only — leave unset or false for normal use
# AXIS_USE_DEV_FIXTURE=false
