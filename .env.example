# Copy to `.env.local` and adjust if needed.
# Never commit `.env.local`.

# ── Production persistence (required on Vercel) ──────────────────────────
# Server-only. Never prefix with NEXT_PUBLIC_.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# ── Local development ───────────────────────────────────────────────────
# Option A: leave TURSO_* unset → uses local file SQLite via libSQL:
#   data/axis-index.db  (or AXIS_INDEX_DB_PATH)
# Option B: point TURSO_DATABASE_URL at your Turso DB (same semantics as prod)
# Option C: TURSO_DATABASE_URL=file:./data/dev.db  (local file, no auth token)

# Optional local path when Turso URL is unset (non-production only)
# AXIS_INDEX_DB_PATH=

# Public Base RPC (server-side only) — optional; defaults to mainnet.base.org
# BASE_RPC_URL=https://mainnet.base.org

# Canonical site origin for share links (optional)
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional Base / Hub tuning — defaults work for most setups
# BASE_LOG_CHUNK_SIZE=10000
# BASE_LOG_CONCURRENCY=4
# BASE_BLOCK_BATCH_SIZE=10
# AXIS_START_BLOCK=43731412
# AXIS_HUB_CACHE_MAX_AGE_MS=300000
# AXIS_HUB_FETCH_BUDGET_MS=45000

# Development only — leave unset or false for production (hard-disabled in prod)
# AXIS_USE_DEV_FIXTURE=false
